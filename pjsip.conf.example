;==========================
; TRANSPORT
;==========================
[transport-udp]
type=transport
protocol=udp
bind=0.0.0.0:5062

;==========================
; EXTENSION 101
;==========================
[101]
type=endpoint
transport=transport-udp
context=default
disallow=all
allow=ulaw,alaw
auth=101
aors=101
direct_media=no

[101]
type=auth
auth_type=userpass
username=101
password=REPLACE_WITH_SECURE_PASSWORD

[101]
type=aor
max_contacts=1
remove_existing=yes

;==========================
; EXTENSION 102
;==========================
[102]
type=endpoint
transport=transport-udp
context=default
disallow=all
allow=ulaw,alaw
auth=102
aors=102
direct_media=no

[102]
type=auth
auth_type=userpass
username=102
password=REPLACE_WITH_SECURE_PASSWORD
  
[102]
type=aor
max_contacts=1
remove_existing=yes
